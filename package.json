{
  "name": "dsh-incident-timeline",
  "version": "0.1.1",
  "engines": {
    "node": ">=22.16.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "description": "Read-only incident timeline for DeepSeek Harness session logs: triage user rejections, plugin errors and runtime HTTP failures into a citable Markdown table.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-incident-timeline": "./bin/incident-timeline.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "prepack": "node scripts/build.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check": "node scripts/build.mjs && node --test && node scripts/check-secrets.mjs && node scripts/check-hygiene.mjs",
    "demo": "node scripts/demo-server.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "incident",
    "timeline",
    "session",
    "observability",
    "postmortem"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-incident-timeline.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-incident-timeline#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-incident-timeline/issues"
  },
  "license": "MIT"
}
